# Server-side only. Set these in your host's environment settings (e.g. Vercel > Settings > Environment Variables).
# Never prefix them with VITE_ - that would put them into browser code.

# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives quote requests
QUOTE_TO_EMAIL=
# Sender on a domain you have verified with Resend, e.g. Wabia <quotes@your-domain.com>
QUOTE_FROM_EMAIL=
